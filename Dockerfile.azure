FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# The browser reaches the application through the same-origin nginx proxy.
# Build arguments intentionally default to relative paths so an old local .env
# cannot bake an external API origin into the Azure image.
ARG VITE_API_BASE_URL=/api
ARG VITE_TICKETING_API_BASE_URL=/api
ARG VITE_API_MODE=live
ARG VITE_KAKAO_MAP_JS_KEY=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_TICKETING_API_BASE_URL=${VITE_TICKETING_API_BASE_URL}
ENV VITE_API_MODE=${VITE_API_MODE}
ENV VITE_KAKAO_MAP_JS_KEY=${VITE_KAKAO_MAP_JS_KEY}
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/dist /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html
COPY nginx.azure.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443
